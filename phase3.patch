+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.data.source.NoResultsException
+import tachiyomi.domain.source.model.SourceNotInstalledException
+import java.net.ConnectException
+import java.net.SocketTimeoutException
+import java.net.UnknownHostException
+
+class BrowseSourceLoadFailureTest {
+
+    @Test
+    fun `valid empty pages are not load failures`() {
+        assertNull(browseSourceLoadFailure(NoResultsException(), null, isHttpSource = true))
+        assertNull(browseSourceLoadFailure(null, NoResultsException(), isHttpSource = true))
+    }
+
+    @Test
+    fun `failed refresh takes precedence over failed append and keeps the original details`() {
+        val refreshError = IllegalStateException("Extension parse error")
+        val failure = requireNotNull(browseSourceLoadFailure(refreshError, HttpException(403), isHttpSource = true))
+
+        assertSame(refreshError, failure.error)
+        assertFalse(failure.isAppend)
+    }
+
+    @Test
+    fun `HTTP errors while loading more results can be checked in WebView`() {
+        val error = HttpException(403)
+        val failure = requireNotNull(browseSourceLoadFailure(null, error, isHttpSource = true))
+
+        assertSame(error, failure.error)
+        assertTrue(failure.isAppend)
+        assertTrue(failure.canOpenWebView)
+    }
+
+    @Test
+    fun `connection and missing source errors do not suggest WebView`() {
+        val errors = listOf(
+            UnknownHostException(),
+            ConnectException(),
+            SocketTimeoutException(),
+            SourceNotInstalledException(),
+        )
+        for (error in errors) {
+            val failure = requireNotNull(browseSourceLoadFailure(error, null, isHttpSource = true))
+            assertFalse(failure.canOpenWebView, error.javaClass.simpleName)
+        }
+    }
+
+    @Test
+    fun `sources without a website do not suggest WebView`() {
+        val error = IllegalStateException("Local source error")
+        val failure = requireNotNull(browseSourceLoadFailure(error, null, isHttpSource = false))
+
+        assertFalse(failure.canOpenWebView)
+    }
+}

+
+internal fun String.webViewHttpUrl(): String? = takeIf { toHttpUrlOrNull() != null }
+
+internal fun ReaderPage.verificationUrl(): String? = imageUrl?.webViewHttpUrl() ?: url.webViewHttpUrl()
+
+internal fun List<ReaderPage>.failedPagesNear(pageIndex: Int): Sequence<ReaderPage> {
+    if (pageIndex !in indices) return emptySequence()
+    val nearby = (pageIndex - 1).coerceAtLeast(0)..(pageIndex + 3).coerceAtMost(lastIndex)
+    return nearby.asSequence()
+        .map { this[it] }
+        .filter { it.status is Page.State.Error }
+}

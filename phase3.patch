@@ -0,0 +1,58 @@
+package eu.kanade.tachiyomi.ui.reader
+
+import eu.kanade.tachiyomi.source.model.Page
+import eu.kanade.tachiyomi.ui.reader.model.ReaderPage
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+
+class ReaderWebViewRecoveryTest {
+
+    @Test
+    fun `returning retries only failed pages near the tapped page`() {
+        val failed = Page.State.Error(IllegalStateException())
+        val pages = listOf(
+            failed,
+            Page.State.Ready,
+            failed,
+            failed,
+            Page.State.DownloadImage,
+            failed,
+            failed,
+            failed,
+        ).mapIndexed { index, state -> ReaderPage(index).apply { status = state } }
+
+        assertEquals(listOf(2, 3, 5, 6), pages.failedPagesNear(3).map(ReaderPage::index).toList())
+    }
+
+    @Test
+    fun `a missing tapped page does not retry unrelated failures`() {
+        val page = ReaderPage(0).apply { status = Page.State.Error(IllegalStateException()) }
+
+        assertEquals(emptyList<ReaderPage>(), listOf(page).failedPagesNear(-1).toList())
+        assertEquals(emptyList<ReaderPage>(), listOf(page).failedPagesNear(1).toList())
+    }
+
+    @Test
+    fun `an image lookup failure can open the original page address`() {
+        val url = "https://example.com/chapter/1/page/3"
+        val page = ReaderPage(2, url)
+
+        assertEquals(url, page.verificationUrl())
+    }
+
+    @Test
+    fun `a failed image uses its original address without changing signed characters`() {
+        val url = "https://cdn.example.com/IMG.webp?key=a%2bb%2F&v=1"
+        val page = ReaderPage(2, "https://example.com/chapter/1", url)
+
+        assertEquals(url, page.verificationUrl())
+    }
+
+    @Test
+    fun `a page without a web address leaves recovery to the chapter address`() {
+        val page = ReaderPage(0, "/chapter/1", "httpx://example.com/image.webp")
+
+        assertNull(page.verificationUrl())
+    }
+}

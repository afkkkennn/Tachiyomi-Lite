+
+@Composable
+internal fun BrowseSourceLoadErrorScreen(
+    failure: BrowseSourceLoadFailure,
+    onRetry: () -> Unit,
+    onWebViewClick: (() -> Unit)?,
+    onHelpClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(
+        modifier = modifier
+            .fillMaxSize()
+            .verticalScroll(rememberScrollState())
+            .padding(24.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp, Alignment.CenterVertically),
+        horizontalAlignment = Alignment.CenterHorizontally,
+    ) {
+        Text(
+            text = failureTitle(failure),
+            style = MaterialTheme.typography.headlineSmall,
+            textAlign = TextAlign.Center,
+            modifier = Modifier.semantics {
+                heading()
+                liveRegion = LiveRegionMode.Polite
+            },
+        )
+        BrowseSourceLoadErrorDetails(failure, onWebViewClick != null, TextAlign.Center)
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(8.dp, Alignment.CenterHorizontally)) {
+            Button(onClick = onRetry) {
+                Text(stringResource(MR.strings.action_retry))
+            }
+            if (onWebViewClick != null) {
+                OutlinedButton(onClick = onWebViewClick) {
+                    Text(stringResource(MR.strings.action_open_in_web_view))
+                }
+            }
+            TextButton(onClick = onHelpClick) {
+                Text(stringResource(MR.strings.label_help))
+            }
+        }
+    }
+}
+
+@Composable
+internal fun BrowseSourceLoadErrorBanner(
+    failure: BrowseSourceLoadFailure,
+    onRetry: () -> Unit,
+    onWebViewClick: (() -> Unit)?,
+    modifier: Modifier = Modifier,
+) {
+    var showDetails by remember(failure) { mutableStateOf(false) }
+    val title = failureTitle(failure)
+    Surface(
+        modifier = modifier.fillMaxWidth(),
+        color = MaterialTheme.colorScheme.errorContainer,
+        contentColor = MaterialTheme.colorScheme.onErrorContainer,
+    ) {
+        Column(modifier = Modifier.padding(start = 12.dp, top = 8.dp, end = 12.dp)) {
+            Text(
+                text = title,
+                style = MaterialTheme.typography.titleSmall,
+                modifier = Modifier.semantics {
+                    heading()
+                    liveRegion = LiveRegionMode.Polite
+                },
+            )
+            val buttonColors = ButtonDefaults.textButtonColors(
+                contentColor = MaterialTheme.colorScheme.onErrorContainer,
+            )
+            FlowRow(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                TextButton(onClick = onRetry, colors = buttonColors) {
+                    Text(stringResource(MR.strings.action_retry))
+                }
+                TextButton(onClick = { showDetails = true }, colors = buttonColors) {
+                    Text(stringResource(MR.strings.action_show_errors))
+                }
+            }
+        }
+    }
+
+    if (showDetails) {
+        AlertDialog(
+            onDismissRequest = { showDetails = false },
+            title = { Text(title) },
+            text = {
+                Column(modifier = Modifier.verticalScroll(rememberScrollState())) {
+                    BrowseSourceLoadErrorDetails(failure, onWebViewClick != null, TextAlign.Start)
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = { showDetails = false }) {
+                    Text(stringResource(MR.strings.action_close))
+                }
+            },
+            confirmButton = {
+                FlowRow(horizontalArrangement = Arrangement.spacedBy(4.dp, Alignment.End)) {
+                    if (onWebViewClick != null) {
+                        TextButton(onClick = {
+                            showDetails = false
+                            onWebViewClick()
+                        }) {
+                            Text(stringResource(MR.strings.action_open_in_web_view))
+                        }
+                    }
+                    TextButton(onClick = {
+                        showDetails = false
+                        onRetry()
+                    }) {
+                        Text(stringResource(MR.strings.action_retry))
+                    }
+                }
+            },
+        )
+    }
+}
+
+@Composable
+private fun BrowseSourceLoadErrorDetails(failure: BrowseSourceLoadFailure, hasWebView: Boolean, textAlign: TextAlign) {
+    val context = LocalContext.current
+    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text(
+            text = with(context) { failure.error.formattedMessage },
+            style = MaterialTheme.typography.bodyMedium,
+            textAlign = textAlign,
+            modifier = Modifier.fillMaxWidth(),
+        )
+        if (hasWebView) {
+            Text(
+                text = stringResource(MR.strings.browse_source_webview_recovery),
+                style = MaterialTheme.typography.bodyMedium,
+                textAlign = textAlign,
+                modifier = Modifier.fillMaxWidth(),
+            )
+        }
+    }
+}
+
+@Composable
+private fun failureTitle(failure: BrowseSourceLoadFailure): String {
+    return stringResource(
+        if (failure.isAppend) MR.strings.browse_source_load_more_failed else MR.strings.browse_source_load_failed,
+    )
+}

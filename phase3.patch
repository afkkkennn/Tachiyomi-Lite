+package eu.kanade.presentation.browse
+
+import tachiyomi.data.source.NoResultsException
+import tachiyomi.domain.source.model.SourceNotInstalledException
+import java.net.SocketException
+import java.net.SocketTimeoutException
+import java.net.UnknownHostException
+
+internal data class BrowseSourceLoadFailure(
+    val error: Throwable,
+    val isAppend: Boolean,
+    val canOpenWebView: Boolean,
+)
+
+internal fun browseSourceLoadFailure(
+    refreshError: Throwable?,
+    appendError: Throwable?,
+    isHttpSource: Boolean,
+): BrowseSourceLoadFailure? {
+    // The paging source also uses an error to report a successfully fetched empty page.
+    val refreshFailure = refreshError?.takeUnless { it is NoResultsException }
+    val error = refreshFailure ?: appendError?.takeUnless { it is NoResultsException } ?: return null
+
+    val canOpenWebView = isHttpSource && when (error) {
+        is SocketException, is SocketTimeoutException, is UnknownHostException, is SourceNotInstalledException -> false
+        else -> true
+    }
+
+    return BrowseSourceLoadFailure(error, isAppend = refreshFailure == null, canOpenWebView = canOpenWebView)
+}
